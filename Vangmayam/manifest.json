{
  "manifest_version": 3,
  "name": "Vangmayam: AI feed reader",
  "version": "0.5.0",
  "description": "A full-page AI reader for the sites you follow. Add any site from the side panel while you browse.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open Vangmayam", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "follow-here": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Add the current site to Vangmayam"
    }
  },
  "permissions": ["sidePanel", "storage", "alarms", "offscreen", "tabs", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"]
}
